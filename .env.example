# Open edX E2E Test Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# Base URL for the Open edX instance
BASE_URL=http://apps.local.openedx.io:1996

# Authoring URL for course management
AUTHORING_URL=http://apps.local.openedx.io:2001/authoring/home

# Test User Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_USERNAME=testuser
TEST_USER_PASSWORD=your_test_password_here

# Admin User Credentials
ADMIN_USER_EMAIL=admin@example.com
ADMIN_USER_USERNAME=adminuser
ADMIN_USER_PASSWORD=your_admin_password_here

# Optional: Set to any value to enable video recording
# RECORD_VIDEO=1
